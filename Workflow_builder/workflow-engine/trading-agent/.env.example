# Alpaca paper trading (free account at alpaca.markets)
# Default BROKER=paper uses yfinance market data plus a local paper book.
# Use NSE/Nifty symbols accepted by yfinance, or override with your own list.
BROKER=paper
WATCHLIST=^NSEI,^NSEBANK,NIFTYBEES.NS,RELIANCE.NS,HDFCBANK.NS,ICICIBANK.NS,INFY.NS

# Optional Alpaca paper trading for US equities only.
# Set BROKER=alpaca to enable these credentials.
ALPACA_API_KEY=PKxxxxxxxxxxxxxxxx
ALPACA_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Default for the headless routine (python3 agent.py). The /api/llm/config
# endpoint in the UI overrides this at runtime — see the provider widget
# top-right in the dashboard.
#
# Choose: gemini (default, free), ollama (fully local), or claude (Anthropic).
LLM_PROVIDER=gemini

# Option A: Google Gemini — free API key at aistudio.google.com
GOOGLE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-2.0-flash   # or gemini-1.5-flash

# Option B: Ollama (local) — install ollama.ai, then: ollama pull llama3.2
# LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2

# Option C: Claude (Anthropic) — get a key at console.anthropic.com
# LLM_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-6

# ── Paper broker tuning ──────────────────────────────────────────────────────
PAPER_STARTING_CASH=100000
PAPER_SPREAD_BPS=5
